BOT_TOKEN=
ADMIN_IDS=123456789

# Для Docker Compose эти значения уже заданы в docker-compose.yml.
# При обычном запуске без Docker можно оставить DATABASE_URL пустым:
# по умолчанию используется постоянный файл data/bot.db.
# На Bothost DATA_DIR=/app/data задаётся платформой автоматически.
# DATA_DIR=/app/data
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# REDIS_URL=redis://localhost:6379/0

ADMIN_CHANNEL_ID=
PAYMENTS_CHANNEL_ID=
PAYMENTS_CHANNEL_LINK=

TGRASS_CODE=
BOTOHUB_KEY=
BOTOHUB_VIEWS_KEY=
PIARFLOW_KEY=
FLYERHUB_KEY=
# Only needed if the FlyerHub bot key is registered as a "webapp" type —
# check via POST https://api.flyerhubs.com/get_me {"key": "..."} → "type".
# webapp-type keys reject /get_tasks and /check_task ("Prohibited method for
# a bot type"); tasks are done inside FlyerHub's own Mini App instead, and
# this is the deep link the "Задания" screen sends users to.
FLYERHUB_WEBAPP_URL=
# linkni.me — last-resort task source, only offered once admin tasks,
# PiarFlow, and FlyerHub all have nothing left for the user. "code" is the
# sell_code from your linkni cabinet (used in both the deep link and the
# GET .../api/subscriptions?code=... status check).
LINKNI_CODE=
